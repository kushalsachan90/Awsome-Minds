{
  "Comment": "Self-Healing Infrastructure Orchestrator",
  "StartAt": "Prepare Incident",
  "States": {
    "Prepare Incident": {
      "Type": "Pass",
      "Parameters": {
        "incidentId.$": "$.id",
        "resourceType": "Lambda",
        "alarmName.$": "$.detail.alarmName",
        "alarmState.$": "$.detail.state.value",
        "alarmReason.$": "$.detail.state.reason",
        "resourceArn": "${FaultyLambdaArn}",
        "source.$": "$.source",
        "account.$": "$.account",
        "region.$": "$.region",
        "eventTime.$": "$.time",
        "metric": "Errors",
        "value": 1,
        "threshold": 0
      },
      "Next": "Lambda Invoke"
    },

    "Lambda Invoke": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",

      "Parameters": {
        "Payload.$": "$",
        "FunctionName": "${DiagnoseFunctionArn}"
      },

      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 3,
          "BackoffRate": 2,
          "JitterStrategy": "FULL"
        }
      ],

      "ResultPath": "$",
      "OutputPath": "$.Payload",
      "Next": "DynamoDB PutItem"
    },

    "DynamoDB PutItem": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:putItem",

      "Parameters": {
        "TableName": "SelfHealingIncidents",
        "Item": {
          "incidentId": {
            "S.$": "$.incidentId"
          }
        }
      },

      "ResultPath": null,

      "Next": "Wait for Approval"
    },

    "Wait for Approval": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke.waitForTaskToken",

      "Parameters": {
        "FunctionName": "${ApprovalFunctionArn}",
        "Payload": {
          "taskToken.$": "$$.Task.Token",
          "incident.$": "$"
        }
      },

      "ResultPath": "$.approval",

      "Next": "Check Approval"
    },

    "Check Approval": {
      "Type": "Choice",

      "Choices": [
        {
          "Variable": "$.approval.approved",
          "BooleanEquals": true,
          "Next": "Apply Fix"
        }
      ],

      "Default": "Approval Rejected"
    },

    "Apply Fix": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",

      "Parameters": {
        "FunctionName": "${ApplyFixFunctionArn}",
        "Payload.$": "$"
      },

      "ResultPath": "$.fixResult",

      "OutputPath": "$",

      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 3,
          "BackoffRate": 2,
          "JitterStrategy": "FULL"
        }
      ],

      "Next": "Fix Completed"
    },

    "Fix Completed": {
      "Type": "Succeed"
    },

    "Approval Rejected": {
      "Type": "Succeed"
    }
  },

  "QueryLanguage": "JSONPath"
}