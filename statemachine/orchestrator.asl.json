
{
  "Comment": "Self-Healing Infrastructure Orchestrator",
  "StartAt": "Determine Event Type",
  "States": {
    "Determine Event Type": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.source",
          "StringEquals": "aws.cloudwatch",
          "Next": "Prepare Incident"
        },
        {
          "Variable": "$.source",
          "StringEquals": "aws.ec2",
          "Next": "Prepare EC2 State Incident"
        }
      ],
      "Default": "Unsupported Event Type"
    },

    "Prepare Incident": {
      "Type": "Pass",
      "Parameters": {
        "incidentId.$": "$.id",
        "alarmName.$": "$.detail.alarmName",
        "alarmState.$": "$.detail.state.value",
        "alarmReason.$": "$.detail.state.reason",
        "source.$": "$.source",
        "account.$": "$.account",
        "region.$": "$.region",
        "eventTime.$": "$.time"
      },
      "Next": "Describe Alarm"
    },

    "Describe Alarm": {
      "Type": "Task",
      "Resource": "arn:aws:states:::aws-sdk:cloudwatch:describeAlarms",
      "Parameters": {
        "AlarmNames.$": "States.Array($.alarmName)"
      },
      "ResultSelector": {
        "namespace.$": "$.MetricAlarms[0].Namespace",
        "metricName.$": "$.MetricAlarms[0].MetricName",
        "threshold.$": "$.MetricAlarms[0].Threshold",
        "statistic.$": "$.MetricAlarms[0].Statistic",
        "period.$": "$.MetricAlarms[0].Period",
        "evaluationPeriods.$": "$.MetricAlarms[0].EvaluationPeriods",
        "dimensions.$": "$.MetricAlarms[0].Dimensions"
      },
      "ResultPath": "$.alarmDetails",
      "Next": "Set Alarm Details"
    },

    "Set Alarm Details": {
      "Type": "Pass",
      "Parameters": {
        "incidentId.$": "$.incidentId",
        "alarmName.$": "$.alarmName",
        "alarmState.$": "$.alarmState",
        "alarmReason.$": "$.alarmReason",
        "source.$": "$.source",
        "account.$": "$.account",
        "region.$": "$.region",
        "eventTime.$": "$.eventTime",

        "resourceType.$": "$.alarmDetails.namespace",
        "metric.$": "$.alarmDetails.metricName",
        "threshold.$": "$.alarmDetails.threshold",
        "statistic.$": "$.alarmDetails.statistic",
        "period.$": "$.alarmDetails.period",
        "evaluationPeriods.$": "$.alarmDetails.evaluationPeriods",
        "dimensions.$": "$.alarmDetails.dimensions"
      },
      "Next": "Determine Resource Type"
    },

    "Determine Resource Type": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.resourceType",
          "StringEquals": "AWS/Lambda",
          "Next": "Set Lambda Resource"
        },
        {
          "Variable": "$.resourceType",
          "StringEquals": "AWS/DynamoDB",
          "Next": "Set DynamoDB Resource"
        },
        {
          "Variable": "$.resourceType",
          "StringEquals": "AWS/EC2",
          "Next": "Set EC2 Resource"
        }
      ],
      "Default": "Unsupported Resource Type"
    },

    "Set Lambda Resource": {
      "Type": "Pass",
      "Parameters": {
        "incidentId.$": "$.incidentId",
        "resourceType": "Lambda",
        "alarmName.$": "$.alarmName",
        "alarmState.$": "$.alarmState",
        "alarmReason.$": "$.alarmReason",

        "resourceName.$": "$.dimensions[0].Value",

        "resourceArn.$": "States.Format('arn:aws:lambda:{}:{}:function:{}', $.region, $.account, $.dimensions[0].Value)",

        "source.$": "$.source",
        "account.$": "$.account",
        "region.$": "$.region",
        "eventTime.$": "$.eventTime",

        "metric.$": "$.metric",
        "value": 1,
        "threshold.$": "$.threshold",

        "statistic.$": "$.statistic",
        "period.$": "$.period",
        "evaluationPeriods.$": "$.evaluationPeriods",
        "dimensions.$": "$.dimensions"
      },
      "Next": "Lambda Invoke"
    },

    "Set DynamoDB Resource": {
      "Type": "Pass",
      "Parameters": {
        "incidentId.$": "$.incidentId",
        "resourceType": "DynamoDB",
        "alarmName.$": "$.alarmName",
        "alarmState.$": "$.alarmState",
        "alarmReason.$": "$.alarmReason",

        "resourceName.$": "$.dimensions[0].Value",

        "resourceArn.$": "States.Format('arn:aws:dynamodb:{}:{}:table/{}', $.region, $.account, $.dimensions[0].Value)",

        "source.$": "$.source",
        "account.$": "$.account",
        "region.$": "$.region",
        "eventTime.$": "$.eventTime",

        "metric.$": "$.metric",
        "value": 1,
        "threshold.$": "$.threshold",

        "statistic.$": "$.statistic",
        "period.$": "$.period",
        "evaluationPeriods.$": "$.evaluationPeriods",
        "dimensions.$": "$.dimensions"
      },
      "Next": "Lambda Invoke"
    },

    "Set EC2 Resource": {
      "Type": "Pass",
      "Parameters": {
        "incidentId.$": "$.incidentId",
        "resourceType": "EC2",
        "alarmName.$": "$.alarmName",
        "alarmState.$": "$.alarmState",
        "alarmReason.$": "$.alarmReason",

        "resourceName.$": "$.dimensions[0].Value",

        "resourceArn.$": "States.Format('arn:aws:ec2:{}:{}:instance/{}', $.region, $.account, $.dimensions[0].Value)",

        "source.$": "$.source",
        "account.$": "$.account",
        "region.$": "$.region",
        "eventTime.$": "$.eventTime",

        "metric.$": "$.metric",
        "value": 1,
        "threshold.$": "$.threshold",

        "statistic.$": "$.statistic",
        "period.$": "$.period",
        "evaluationPeriods.$": "$.evaluationPeriods",
        "dimensions.$": "$.dimensions"
      },
      "Next": "Lambda Invoke"
    },

    "Prepare EC2 State Incident": {
      "Type": "Pass",
      "Parameters": {
        "incidentId.$": "$.id",
        "resourceType": "EC2",

        "resourceName.$": "$['detail']['instance-id']",

        "resourceArn.$": "States.Format('arn:aws:ec2:{}:{}:instance/{}', $.region, $.account, $['detail']['instance-id'])",

        "source.$": "$.source",
        "account.$": "$.account",
        "region.$": "$.region",
        "eventTime.$": "$.time",

        "ec2State.$": "$['detail']['state']",

        "eventType": "EC2_STATE_CHANGE",

        "metric": "InstanceState",
        "value": 1,
        "threshold": 1,

        "statistic": "StateChange",
        "period": 0,
        "evaluationPeriods": 1,

        "alarmName": "EC2-State-Change",
        "alarmState": "ALARM",
        "alarmReason": "EC2 instance state changed",

        "dimensions": [
          {
            "Name": "InstanceId",
            "Value.$": "$['detail']['instance-id']"
          }
        ]
      },
      "Next": "Lambda Invoke"
    },

    "Unsupported Event Type": {
      "Type": "Fail",
      "Error": "UnsupportedEventType",
      "Cause": "The event source is not supported."
    },

    "Unsupported Resource Type": {
      "Type": "Fail",
      "Error": "UnsupportedResourceType",
      "Cause": "The CloudWatch alarm namespace is not supported."
    },

    "Lambda Invoke": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "Payload.$": "$",
        "FunctionName": "${DiagnoseFunctionArn}"
      },
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 3,
          "BackoffRate": 2,
          "JitterStrategy": "FULL"
        }
      ],
      "ResultPath": "$",
      "OutputPath": "$.Payload",
      "Next": "DynamoDB PutItem"
    },

    "DynamoDB PutItem": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:putItem",
      "Parameters": {
        "TableName": "SelfHealingIncidents",
        "Item": {
          "incidentId": {
            "S.$": "$.incidentId"
          },
          "resourceType": {
            "S.$": "$.resourceType"
          },
          "resourceArn": {
            "S.$": "$.resourceArn"
          },
          "metric": {
            "S.$": "$.metric"
          },
          "metricValue": {
            "N.$": "States.Format('{}', $.value)"
          },
          "threshold": {
            "N.$": "States.Format('{}', $.threshold)"
          },
          "diagnosedAt": {
            "S.$": "$$.State.EnteredTime"
          },
          "rootCause": {
            "S.$": "$.rootCause"
          },
          "severity": {
            "S.$": "$.severity"
          },
          "reason": {
            "S.$": "$.reason"
          },
          "confidence": {
            "N.$": "States.Format('{}', $.confidence)"
          },
          "confidenceReason": {
            "S.$": "$.confidenceReason"
          },
          "blastRadius": {
            "S.$": "$.blastRadius"
          },
          "blastRadiusReason": {
            "S.$": "$.blastRadiusReason"
          },
          "estimatedCostImpact": {
            "S.$": "$.estimatedCostImpact"
          },
          "fixAction": {
            "S.$": "$.fix.action"
          },
          "fixParameters": {
            "S.$": "States.JsonToString($.fix.parameters)"
          }
        }
      },
      "ResultPath": null,
      "Next": "Wait for Approval"
    },

    "Wait for Approval": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke.waitForTaskToken",
      "Parameters": {
        "FunctionName": "${ApprovalFunctionArn}",
        "Payload": {
          "taskToken.$": "$$.Task.Token",
          "incident.$": "$"
        }
      },
      "ResultPath": "$.approval",
      "Catch": [
        {
          "ErrorEquals": [
            "RejectedByOperator"
          ],
          "ResultPath": "$.approval",
          "Next": "Approval Rejected"
        }
      ],
      "Next": "Check Approval"
    },

    "Check Approval": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.approval.approved",
          "BooleanEquals": true,
          "Next": "Apply Fix"
        }
      ],
      "Default": "Approval Rejected"
    },

    "Apply Fix": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${ApplyFixFunctionArn}",
        "Payload.$": "$"
      },
      "ResultPath": "$.fixResult",
      "OutputPath": "$",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "Lambda.TooManyRequestsException"
          ],
          "IntervalSeconds": 1,
          "MaxAttempts": 3,
          "BackoffRate": 2,
          "JitterStrategy": "FULL"
        }
      ],
      "Next": "DynamoDB UpdateItem"
    },

    "DynamoDB UpdateItem": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Parameters": {
        "TableName": "SelfHealingIncidents",
        "Key": {
          "incidentId": {
            "S.$": "$.incidentId"
          }
        },
        "UpdateExpression": "SET approvalStatus = :approved, approvedBy = :approvedBy, approvedAt = :approvedAt, fixStatus = :fixStatus, fixResult = :fixResult",
        "ExpressionAttributeValues": {
          ":approved": {
            "S": "APPROVED"
          },
          ":approvedBy": {
            "S.$": "$.approval.approvedBy"
          },
          ":approvedAt": {
            "S.$": "$.approval.approvedAt"
          },
          ":fixStatus": {
            "S": "COMPLETED"
          },
          ":fixResult": {
            "S.$": "States.JsonToString($.fixResult.Payload)"
          }
        }
      },
      "ResultPath": null,
      "Next": "Fix Completed"
    },

    "Fix Completed": {
      "Type": "Succeed"
    },

    "Approval Rejected": {
      "Type": "Task",
      "Resource": "arn:aws:states:::dynamodb:updateItem",
      "Parameters": {
        "TableName": "SelfHealingIncidents",
        "Key": {
          "incidentId": {
            "S.$": "$.incidentId"
          }
        },
        "UpdateExpression": "SET approvalStatus = :rejected, fixStatus = :notApplied",
        "ExpressionAttributeValues": {
          ":rejected": {
            "S": "REJECTED"
          },
          ":notApplied": {
            "S": "NOT_APPLIED"
          }
        }
      },
      "ResultPath": null,
      "Next": "Approval Rejected Completed"
    },

    "Approval Rejected Completed": {
      "Type": "Succeed"
    }
  },
  "QueryLanguage": "JSONPath"
}

